# ---- Local Postgres (self-host, no Supabase) ----
DATABASE_URL=postgres://edufarm:CHANGE_ME@localhost:5432/edufarm_dev
DATABASE_URL_PROD=postgres://edufarm:CHANGE_ME@localhost:5432/edufarm_prod

# ---- Better Auth ----
BETTER_AUTH_SECRET=CHANGE_ME_32_CHARS_MIN
BETTER_AUTH_URL=http://localhost:3000

# ---- Email (6-digit verification codes + reset + lecturer notices) ----
# Option A (recommended until you own a domain): Gmail SMTP — free, reaches
# any inbox. Needs 2-Step Verification + an App Password on the Gmail account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B: Resend. Dev: leave empty to log codes to the server terminal.
# Test sender reaches only your own email; verified domain reaches everyone.
# Codes expire in 10 minutes, 3 attempts max, resend rate-limited.
RESEND_API_KEY=
EMAIL_FROM=EduFarm <no-reply@example.com>

# ---- Cloudflare R2 (private buckets, presigned URLs only) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edufarm-dev
R2_ENDPOINT=https://ACCOUNTID.r2.cloudflarestorage.com

# ---- AI (Phase 8; student + lecturer assistants call this at runtime) ----
# Any OpenAI-compatible endpoint works. Until set, /ai shows "not configured".
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
